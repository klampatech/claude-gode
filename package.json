{
  "name": "claude-code",
  "version": "0.0.0",
  "description": "CLI tool powered by Google ADK with 40+ tools, multi-agent orchestration, terminal UI (React/Ink), and IDE bridge integration",
  "type": "module",
  "main": "src/main.tsx",
  "bin": {
    "claude": "./src/main.tsx"
  },
  "scripts": {
    "build": "bun build src/main.tsx --outdir dist --target node",
    "dev": "bun --watch src/main.tsx",
    "start": "bun src/main.tsx",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.tsx"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.30.1",
    "@google/adk": "^0.6.1",
    "blessed": "^0.1.81",
    "blessed-contrib": "^4.10.1",
    "boxen": "^7.1.1",
    "chalk": "^5.3.0",
    "cli-progress": "^3.12.0",
    "commander": "^12.1.0",
    "dotenv": "^16.4.5",
    "enquirer": "^2.4.1",
    "execa": "^9.3.1",
    "ini": "^5.0.0",
    "ink": "^4.4.1",
    "nanospinner": "^1.2.1",
    "node-pty": "^1.0.0",
    "open": "^10.1.0",
    "ora": "^8.0.1",
    "pino": "^9.3.2",
    "pino-pretty": "^11.2.2",
    "react": "^18.3.1",
    "sharp": "^0.33.5",
    "signale": "^1.4.0",
    "toml": "^3.0.0",
    "uuid": "^10.0.0",
    "which": "^4.0.0",
    "ws": "^8.17.1",
    "yaml": "^2.4.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/ws": "^8.5.12",
    "@types/uuid": "^10.0.0",
    "@types/which": "^3.0.4",
    "@types/ini": "^4.1.1",
    "@types/signale": "^1.4.7",
    "typescript": "^5.5.2",
    "eslint": "^8.57.0",
    "@typescript-eslint/eslint-plugin": "^7.13.1",
    "@typescript-eslint/parser": "^7.13.1",
    "prettier": "^3.3.2",
    "bun-types": "^1.1.17"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
