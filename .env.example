# Claude Code Environment Variables

# Required - Google ADK API key for AI processing
CLAUDE_API_KEY=

# Optional - Project directory to operate on (defaults to cwd)
CLAUDE_PROJECT_PATH=

# Optional - Max messages in context window (default: 100)
CLAUDE_CONTEXT_WINDOW=100

# Optional - Permission mode: ask/allow/deny/limited (default: ask)
CLAUDE_PERMISSION_MODE=ask

# Optional - Logging level: debug/info/warn/error (default: info)
LOG_LEVEL=info

# Optional - Custom memory directory path (default: ./memdir)
CLAUDE_MEMDIR=

# Optional - Maximum agent pool size (default: 10)
CLAUDE_MAX_AGENTS=10

# Optional - Enable autoDream for background memory consolidation (default: false)
CLAUDE_AUTO_DREAM=false

# Optional - AutoDream trigger interval in hours (default: 24)
CLAUDE_DREAM_INTERVAL=24
